# Sidecar-only git environment (Wave 4 shell must set these on the Python process).
# Do NOT export into the Tauri shell's own process environment for general use —
# only the langflow sidecar child inherits this block.
#
# Paths are relative to {install_dir}/resources/git unless absolute.
# Resolve to absolute paths before spawn.

# --- Linux (vendored from versions.lock git.linux) ---
# PATH_PREPEND={install_dir}/resources/git/bin
# GIT_EXEC_PATH={install_dir}/resources/git/libexec/git-core

# --- Windows (MinGit from versions.lock git.windows_mingit) ---
# PATH_PREPEND=
#   {install_dir}/resources/git/cmd;
#   {install_dir}/resources/git/usr/bin;
#   {install_dir}/resources/git/mingw64/bin
# GIT_EXEC_PATH={install_dir}/resources/git/mingw64/libexec/git-core

# Example absolute forms after Stage0 resolves install_dir (Linux):
PATH_PREPEND=/opt/farhad-flow-ci/resources/git/bin
GIT_EXEC_PATH=/opt/farhad-flow-ci/resources/git/libexec/git-core

# Optional hardening for sidecar only:
# GIT_CONFIG_NOSYSTEM=1
# (staff may still set user.name/email via LANGFLOW / wizard; do not wipe HOME)

# Policy:
# - Bundled git preferred (PATH prepend).
# - System git optional fallback only if bundle missing (Stage0 should fail-fast if bundle missing).
# - No git at all → existing Langflow git error catalog (do not invent new UX here).
