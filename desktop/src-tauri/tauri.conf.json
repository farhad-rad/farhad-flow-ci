{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Farhad Flow CI",
  "version": "0.1.0",
  "identifier": "ci.zeenome.farhadflow",
  "mainBinaryName": "FarhadFlowCI",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Farhad Flow CI",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources": "resources"
    },
    "shortDescription": "Farhad Flow CI — staff desktop IDE for flows",
    "longDescription": "Unsigned staff-only Tauri shell for Farhad Flow CI. Ships frozen Python, baked frontend, and portable git. Flows repo and PAT live under the user config directory, not the package.",
    "category": "DeveloperTool",
    "linux": {
      "deb": {
        "section": "devel",
        "priority": "optional",
        "desktopTemplate": "linux/farhad-flow-ci.desktop",
        "postInstallScript": "linux/postinst.sh",
        "postRemoveScript": "linux/postrm.sh"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "./nsis/hooks.nsh",
        "startMenuFolder": "Farhad Flow CI"
      }
    }
  },
  "plugins": {}
}
